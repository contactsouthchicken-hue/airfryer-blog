---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas ou plus.">
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <h1 class="text-3xl font-bold text-slate-900">404</h1>
    <p class="mt-4 text-slate-600">Cette page n'existe pas ou plus.</p>
    <a href="/" class="mt-6 inline-block text-orange-600 hover:underline">Retour à l'accueil</a>
  </div>
</BaseLayout>
