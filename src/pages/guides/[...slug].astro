---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const relatedGuides = (await getCollection('guides', ({ data }) => !data.draft))
  .filter((g) => g.id !== guide.id && g.data.category === guide.data.category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((g) => ({
    slug: g.id,
    title: g.data.title,
    description: g.data.description,
    category: g.data.category,
    pubDate: g.data.pubDate,
    image: g.data.image,
  }));
---

<GuideLayout
  title={guide.data.title}
  description={guide.data.description}
  category={guide.data.category}
  pubDate={guide.data.pubDate}
  updatedDate={guide.data.updatedDate}
  image={guide.data.image}
  keywords={guide.data.keywords}
  relatedGuides={relatedGuides}
>
  <Content />
</GuideLayout>
