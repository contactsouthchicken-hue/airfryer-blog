---
import { CATEGORIES } from '../data/site';

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  pubDate: Date;
  image: string;
}

const { slug, title, description, category, pubDate, image } = Astro.props;
const categoryLabel = CATEGORIES.find((c) => c.slug === category)?.label ?? category;
---

<a
  href={`/guides/${slug}/`}
  class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md"
>
  <img src={image} alt={title} loading="lazy" class="h-40 w-full object-cover" />
  <div class="flex flex-1 flex-col p-4">
    <span class="mb-2 w-fit rounded-full bg-orange-100 px-2.5 py-0.5 text-xs font-semibold text-orange-700">
      {categoryLabel}
    </span>
    <h3 class="text-base font-semibold text-slate-900 group-hover:text-orange-600">{title}</h3>
    <p class="mt-1 line-clamp-3 text-sm text-slate-600">{description}</p>
    <time datetime={pubDate.toISOString()} class="mt-3 text-xs text-slate-400">
      {pubDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
    </time>
  </div>
</a>
