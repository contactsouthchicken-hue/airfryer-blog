---
import { buildAmazonLink, getProduct } from '../lib/amazon';

interface Props {
  productKey: string;
}

const { productKey } = Astro.props;
const product = getProduct(productKey);
---

{
  product && (
    <div class="not-prose my-6 flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row">
      <img
        src={product.image}
        alt={product.name}
        width="160"
        height="160"
        loading="lazy"
        class="mx-auto h-40 w-40 rounded-lg object-cover sm:mx-0"
      />
      <div class="flex flex-1 flex-col">
        <h3 class="text-lg font-semibold text-slate-900">{product.name}</h3>
        <p class="mt-1 text-sm text-slate-600">{product.pitch}</p>
        <div class="mt-3 grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
          <ul class="list-inside list-disc text-green-700">
            {product.pros.map((pro) => <li>{pro}</li>)}
          </ul>
          <ul class="list-inside list-disc text-red-700">
            {product.cons.map((con) => <li>{con}</li>)}
          </ul>
        </div>
        <a
          href={buildAmazonLink(product.asin)}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="mt-4 inline-block w-fit rounded-lg bg-orange-500 px-5 py-2 text-sm font-semibold text-white hover:bg-orange-600"
        >
          Voir le prix sur Amazon
        </a>
      </div>
    </div>
  )
}
